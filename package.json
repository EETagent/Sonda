{
  "name": "sonda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @sonda/demo dev",
    "dev:demo": "pnpm --filter @sonda/demo dev",
    "dev:backend": "pnpm --filter @sonda/backend dev",
    "build": "pnpm --filter @sonda/client build && pnpm --filter @sonda/backend build && pnpm --filter @sonda/demo build",
    "build:client": "pnpm --filter @sonda/client build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:browser": "playwright test",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "svelte": "^5.57.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.6.0"
}
