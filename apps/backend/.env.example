# Development: pnpm dev:backend. Production: pnpm --filter @sonda/backend build && pnpm --filter @sonda/backend start
HOST=127.0.0.1
PORT=3001
# Set ORIGIN to the public backend URL when deploying behind a reverse proxy.
ORIGIN=http://127.0.0.1:3001
BODY_SIZE_LIMIT=26214400
# Relative to apps/backend when using the workspace scripts. Mount a persistent volume in production.
SONDA_DATA_DIR=./data/submissions
# Comma-separated browser origins that may submit. Same-origin requests are always allowed.
# Unset: local backends accept localhost/loopback origins on any port.
# Setting this overrides that default, even locally.
# SONDA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# This local-development inbox does not implement authentication. Add it before exposing real captures publicly.
# Vercel: connect a PRIVATE Blob store to populate this server-only token.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# On Vercel, set SONDA_ALLOWED_ORIGINS to the demo HTTPS origin instead of localhost.
# Demo-only ephemeral memory storage (no Blob token required):
# SONDA_STORAGE_PROVIDER=mock
